<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.department.mapper.DepartmentMapper">

    <resultMap type="Department" id="DepartmentResult">
        <result property="deptId"    column="dept_id"    />
        <result property="deptName"    column="dept_name"    />
        <result property="deptAddress"    column="dept_address"    />
        <result property="deptPhone"    column="dept_phone"    />
    </resultMap>

    <sql id="selectDepartmentVo">
        select dept_id, dept_name, dept_address, dept_phone from department
    </sql>

    <select id="selectDepartmentList" parameterType="Department" resultMap="DepartmentResult">
        <include refid="selectDepartmentVo"/>
        <where>
            <if test="deptId != null "> and dept_id = #{deptId}</if>
            <if test="deptName != null  and deptName != ''"> and dept_name like concat('%', #{deptName}, '%')</if>
        </where>
    </select>

    <select id="selectDepartmentByDeptId" parameterType="Long" resultMap="DepartmentResult">
        <include refid="selectDepartmentVo"/>
        where dept_id = #{deptId}
    </select>

    <insert id="insertDepartment" parameterType="Department">
        insert into department
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="deptId != null">dept_id,</if>
            <if test="deptName != null and deptName != ''">dept_name,</if>
            <if test="deptAddress != null">dept_address,</if>
            <if test="deptPhone != null">dept_phone,</if>
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="deptId != null">#{deptId},</if>
            <if test="deptName != null and deptName != ''">#{deptName},</if>
            <if test="deptAddress != null">#{deptAddress},</if>
            <if test="deptPhone != null">#{deptPhone},</if>
        </trim>
    </insert>

    <update id="updateDepartment" parameterType="Department">
        update department
        <trim prefix="SET" suffixOverrides=",">
            <if test="deptName != null and deptName != ''">dept_name = #{deptName},</if>
            <if test="deptAddress != null">dept_address = #{deptAddress},</if>
            <if test="deptPhone != null">dept_phone = #{deptPhone},</if>
        </trim>
        where dept_id = #{deptId}
    </update>

    <delete id="deleteDepartmentByDeptId" parameterType="Long">
        delete from department where dept_id = #{deptId}
    </delete>

    <delete id="deleteDepartmentByDeptIds" parameterType="String">
        delete from department where dept_id in
        <foreach item="deptId" collection="array" open="(" separator="," close=")">
            #{deptId}
        </foreach>
    </delete>

    <select id="selectDepartmentCount" resultType="Long">
        select count(*) from department
    </select>
</mapper>